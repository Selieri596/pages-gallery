# ============================================================
#  .env.example —— 只放「键名」和假值，用来告诉 agent 该读环境变量
#  复制成 .env 后填真实值；.env 已被 .gitignore 忽略，永不入库
# ============================================================

# ---------- 应用 ----------
APP_NAME=my-project
APP_ENV=development
LOG_LEVEL=debug

# ---------- 数据库 ----------
DATABASE_URL=postgresql://user:CHANGE_ME@localhost:5432/mydb
REDIS_URL=redis://localhost:6379/0

# ---------- 第三方服务（一律用占位符，不要填真实 key）----------
OPENAI_API_KEY=sk-REPLACE_ME
GITHUB_TOKEN=ghp_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
SMTP_PASSWORD=REPLACE_ME

# ---------- 本地个人配置（不属于项目，另行放在 personal/ 下）----------
# 例如真实姓名、手机号、内网地址 —— 这些不要写进本文件
