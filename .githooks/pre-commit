#!/bin/sh
# ============================================================
#  .githooks/pre-commit —— 提交前闸门入口（无扩展名，git 一定能找到）
#
#  为什么是无扩展名：
#  git 解析钩子时优先找「精确文件名」，只有在找不到时才按 PATHEXT
#  试 .exe/.cmd 等。实测在 Windows 上把钩子写成 pre-commit.cmd 时
#  git 不会执行它，所以这里保留无扩展名的入口。
#
#  分工：
#    本文件          入口：Windows 上转交 PowerShell，类 Unix 上直接扫描
#    pre-commit.ps1  Windows 检查逻辑（含退出码语义判断）
#    pre-commit.cmd  Windows 兜底入口（当 /bin/sh 不可用时）
#
#  ⚠ 重要：本文件本身也会被 /bin/sh 解释。在受限环境里 /bin/sh 可能
#    起不来（"couldn't create signal pipe, Win32 error 5"），此时 git
#    会**静默跳过**钩子。所以钩子只能当「第二道防线」，
#    真正的发布门禁请使用 tools/publish.ps1（不依赖 git 钩子）。
# ============================================================

# ---------------- Windows：交给 PowerShell ----------------
case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*)
    for ps in pwsh powershell.exe powershell; do
      if command -v "$ps" >/dev/null 2>&1; then
        d=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
        exec "$ps" -NoProfile -ExecutionPolicy Bypass -File "$d/pre-commit.ps1" "$@"
      fi
    done
    echo "pre-commit: 未找到 PowerShell，无法执行密钥扫描。" >&2
    exit 1
    ;;
esac

# ---------------- 类 Unix：直接扫描 ----------------
git diff --cached --quiet && exit 0

if command -v gitleaks >/dev/null 2>&1; then
  :
elif [ -x "${GIT_DIR:-.git}/../.gitleaks-bin/gitleaks" ]; then
  PATH="$(cd "${GIT_DIR:-.git}/.." && pwd)/.gitleaks-bin:$PATH"
  export PATH
else
  echo "pre-commit: 未安装 gitleaks，本次提交未做密钥扫描。" >&2
  echo "  安装：https://github.com/gitleaks/gitleaks/releases" >&2
  exit 0
fi

cfg=""
[ -f .gitleaks.toml ] && cfg="--config .gitleaks.toml"

echo "> 正在扫描暂存内容（gitleaks）..."
gitleaks protect --staged --redact -v $cfg
code=$?

if [ "$code" -eq 0 ]; then
  echo "  ok 未发现疑似密钥，允许提交"
  exit 0
fi

if [ "$code" -ne 1 ]; then
  echo "扫描器执行失败（gitleaks exit=$code），已阻止提交。" >&2
  echo "通常说明 .gitleaks.toml 里的正则不被 RE2 支持：" >&2
  echo "  不支持环视断言 (?<! (?<= (?= (?! 以及 \\b" >&2
  exit 1
fi

cat >&2 <<'EOF'

──────────────────────────────────────────
 提交已被阻止：暂存内容中检测到疑似密钥 / 隐私信息

 处理步骤：
   1) git restore --staged <文件>      取消暂存该文件
   2) 把真实值移入 .env（已被 .gitignore 忽略），源码改读环境变量
   3) 若该密钥已进入过任何一次提交：立刻去服务商后台「轮换 / 撤销」
   4) 确认是误报才用：git commit --no-verify
──────────────────────────────────────────
EOF
exit 1
